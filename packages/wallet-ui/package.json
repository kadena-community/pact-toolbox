{
  "name": "@pact-toolbox/wallet-ui",
  "version": "0.1.0",
  "description": "Cross-framework wallet UI components for pact-toolbox using SolidJS and ui-shared",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "default": "./dist/angular.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "serve": "vite",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@pact-toolbox/crypto": "workspace:*",
    "@pact-toolbox/network-config": "workspace:*",
    "@pact-toolbox/signers": "workspace:*",
    "@pact-toolbox/types": "workspace:*",
    "@pact-toolbox/ui-shared": "workspace:*",
    "@pact-toolbox/utils": "workspace:*",
    "@pact-toolbox/wallet-core": "workspace:*",
    "clsx": "^2.1.1",
    "goober": "^2.1.16",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@angular/core": "^20.3.1",
    "@pact-toolbox/tsconfig": "workspace:*",
    "@pact-toolbox/tsdown": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "jsdom": "^27.0.0",
    "oxlint": "^1.16.0",
    "react": "^19.1.1",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4",
    "vue": "^3.5.21"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "keywords": [
    "kadena",
    "pact",
    "wallet",
    "web3",
    "solidjs",
    "ui-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/salamaashoush/pact-toolbox.git",
    "directory": "packages/wallet-ui"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
