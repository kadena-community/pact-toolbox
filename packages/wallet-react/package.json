{
  "name": "@pact-toolbox/wallet-react",
  "version": "0.1.0",
  "description": "React integration for Kadena wallet manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/pact-toolbox.git",
    "directory": "packages/wallet-react"
  },
  "author": "Pact Toolbox Team",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@pact-toolbox/wallet-core": "workspace:*",
    "@pact-toolbox/wallet-manager": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pact-toolbox/tsdown": "workspace:*",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^27.0.0",
    "oxlint": "^1.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "pact",
    "kadena",
    "wallet",
    "react",
    "blockchain"
  ],
  "publishConfig": {
    "access": "public"
  }
}
